{
  "version": "1.0",
  "ai": {
    "provider": "minimax",
    "model": "abab6.5s-chat",
    "api_key_env": "MINIMAX_API_KEY",
    "base_url": "https://api.minimax.chat/v1",
    "temperature": 0.3,
    "max_tokens": 4096,
    "languages": ["zh", "en"]
  },
  "email": {
    "enabled": false
  },
  "sources": {
    "github": [
      {
        "type": "repo_releases",
        "owner": "yugabyte",
        "repo": "yugabyte-db",
        "enabled": true
      },
      {
        "type": "repo_releases",
        "owner": "anthropic",
        "repo": "anthropic-sdk-python",
        "enabled": false
      }
    ],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 10,
      "min_score": 50
    },
    "rss": [
      {
        "name": "Yugabyte Blog",
        "url": "https://www.yugabyte.com/blog/feed/",
        "enabled": false,
        "category": "database"
      },
      {
        "name": "OpenAI Blog",
        "url": "https://openai.com/blog/rss.xml",
        "enabled": true,
        "category": "ai"
      },
      {
        "name": "Hugging Face",
        "url": "https://huggingface.co/blog/feed.xml",
        "enabled": true,
        "category": "ai"
      },
      {
        "name": "TechCrunch",
        "url": "https://techcrunch.com/feed/",
        "enabled": true,
        "category": "tech"
      }
    ],
    "reddit": {
      "enabled": true,
      "subreddits": [
        {"subreddit": "YugabyteDB", "enabled": true, "min_score": 0},
        {"subreddit": "distributedcomputing", "enabled": true, "min_score": 0},
        {"subreddit": "Database", "enabled": true, "min_score": 0}
      ],
      "users": []
    }
  },
  "filtering": {
    "ai_score_threshold": 8.0,
    "time_window_hours": 24
  }
}
